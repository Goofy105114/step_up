# ─── Database (Neon Serverless Postgres) ───────────────────────────────────────
# Get your connection string from https://neon.tech → Project → Connection string
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/footwear_db?sslmode=require

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:5173
# Production (your Vercel domain):
# FRONTEND_URL=https://your-app.vercel.app
