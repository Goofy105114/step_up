# ── Copy this file to .env and fill in your values ─────────────────────

# DATABASE — pick one:
# Local:
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost/footwear_db
# Supabase (recommended for production):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

PORT=4000
NODE_ENV=development   # change to "production" on Render

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Get from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Your Vercel frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# Email delivery (Resend) - set in Render, never commit real values
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# OTP delivery (MSG91 OTP Widget) - set in Render, never commit real values
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
