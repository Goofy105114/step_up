{
  "name": "stepup-footwear",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api":      "npm run dev  --prefix api",
    "dev:frontend": "npm run dev  --prefix frontend",
    "dev":          "concurrently -n api,frontend -c cyan,magenta \"npm run dev:api\" \"npm run dev:frontend\"",
    "build":        "npm run build --prefix frontend",
    "install:all":  "npm install --prefix api && npm install --prefix frontend",
    "db:migrate":   "npm run db:migrate --prefix api",
    "db:seed":      "npm run db:seed    --prefix api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
